{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/orwa-mahmoud/nightshift/main/plugins/nightshift/skills/nightshift/references/schemas/v1/pr-readiness-evidence.json",
  "title": "Nightshift pull-request readiness evidence",
  "description": "Structured outputs for branch-scoped acceptance mapping, diff scope, review maps, and owner-only action refusals.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1] },
    "kind": {
      "type": "string",
      "enum": ["acceptance-map", "review-map", "diff-scope", "owner-action-refusal"]
    }
  }
}
