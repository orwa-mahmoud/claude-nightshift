{
  "capabilityId": "coverage",
  "detect": {
    "manager": "go",
    "manifest": "go.mod"
  },
  "ecosystems": [
    "go"
  ],
  "elevationCategories": [],
  "enabledShifts": [
    "coverage-hunt",
    "quality"
  ],
  "lastVerified": "2026-09-02",
  "maintenance": {
    "check": "the Go release notes for a change to `-cover` reporting: a package with no test files must keep reporting no coverage, never zero percent",
    "resolves": "go help testflag"
  },
  "minimalConfig": {},
  "packageManagerAdditions": [],
  "permissionRequirements": [],
  "probe": {
    "command": "go version",
    "presentOnExitZero": true
  },
  "recipeVersion": "1",
  "rollback": {
    "command": "true"
  },
  "safetyClass": "local-dev-free",
  "smoke": {
    "command": "go test -cover ./..."
  },
  "upstream": "https://pkg.go.dev/cmd/go#hdr-Testing_flags",
  "versionConstraints": {
    "go": ">=1.21"
  },
  "allowedFiles": []
}
