{
  "capabilityId": "documentation-link",
  "detect": {
    "manager": "cargo",
    "manifest": "Cargo.toml"
  },
  "ecosystems": [
    "rust"
  ],
  "elevationCategories": [],
  "enabledShifts": [
    "documentation-drift",
    "documentation-writing"
  ],
  "lastVerified": "2026-09-02",
  "maintenance": {
    "check": "the rustdoc lint list for a rename of `rustdoc::broken_intra_doc_links` or a change to its default level",
    "resolves": "cargo doc --help"
  },
  "minimalConfig": {},
  "packageManagerAdditions": [],
  "permissionRequirements": [],
  "probe": {
    "command": "cargo --version",
    "presentOnExitZero": true
  },
  "recipeVersion": "1",
  "rollback": {
    "command": "true"
  },
  "safetyClass": "local-dev-free",
  "smoke": {
    "command": "RUSTDOCFLAGS=\"-D rustdoc::broken_intra_doc_links\" cargo doc --no-deps"
  },
  "upstream": "https://doc.rust-lang.org/rustdoc/lints.html",
  "versionConstraints": {
    "cargo": ">=1.70"
  },
  "allowedFiles": []
}
