{
  "capabilityId": "typecheck",
  "detect": {
    "manager": "cargo",
    "manifest": "Cargo.toml"
  },
  "ecosystems": [
    "rust"
  ],
  "elevationCategories": [],
  "enabledShifts": [
    "clear-quality-debt",
    "dead-code-cleanup",
    "quality"
  ],
  "lastVerified": "2026-09-02",
  "maintenance": {
    "check": "the cargo-check page for a change to `--all-targets` or to the diagnostic format",
    "resolves": "cargo check --help"
  },
  "minimalConfig": {},
  "packageManagerAdditions": [],
  "permissionRequirements": [],
  "probe": {
    "command": "cargo --version",
    "presentOnExitZero": true
  },
  "recipeVersion": "1",
  "rollback": {
    "command": "true"
  },
  "safetyClass": "local-dev-free",
  "smoke": {
    "command": "cargo check --all-targets"
  },
  "upstream": "https://doc.rust-lang.org/cargo/commands/cargo-check.html",
  "versionConstraints": {
    "cargo": ">=1.70"
  },
  "allowedFiles": []
}
