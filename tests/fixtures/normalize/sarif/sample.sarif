{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": { "driver": { "name": "semgrep", "version": "1.60.0" } },
      "results": [
        {
          "ruleId": "javascript.express.security.audit.xss",
          "level": "error",
          "message": { "text": "Detected directly writing user input into the response." },
          "locations": [
            { "physicalLocation": { "artifactLocation": { "uri": "src/server/routes.js" }, "region": { "startLine": 88, "startColumn": 5 } } }
          ]
        },
        {
          "ruleId": "javascript.lang.correctness.useless-eqeq",
          "level": "warning",
          "message": { "text": "This comparison is always true." },
          "locations": [
            { "physicalLocation": { "artifactLocation": { "uri": "src/app.js" }, "region": { "startLine": 14 } } }
          ]
        },
        {
          "ruleId": "generic.secrets.hardcoded-token",
          "message": { "text": "Possible hardcoded token." },
          "locations": [
            { "physicalLocation": { "artifactLocation": { "uri": "src/app.js" }, "region": { "startLine": 3 } } }
          ]
        },
        {
          "ruleId": "config.missing-baseline",
          "level": "note",
          "message": { "text": "No baseline file was supplied, so every finding is reported as new." }
        }
      ]
    }
  ]
}
